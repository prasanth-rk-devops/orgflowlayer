NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://orgflow:orgflow@localhost:5432/orgflow
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@orgflow.local
ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true
UPLOAD_DIR=./uploads
APP_URL=http://localhost:5173
# Email (leave empty to disable; for local testing use MailHog: host=localhost port=1025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=OrgFlow <no-reply@yourcompany.com>
